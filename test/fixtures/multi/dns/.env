# See test/fixtures/shop/.env for what these are. This stack deliberately uses
# a different subnet, so a leftover shop stack cannot make it look broken.
#
# This is the whole multi fixture's addressing, not just this stack's: alpha and
# beta resolve through IPV4_COREDNS and have no copy of it. The suite reads this
# file and hands it to them, so the address is written once.
IPV4_GATEWAY=10.233.134.1
IPV4_COREDNS=10.233.134.11
INCUS_PORT=8443

# Overwritten by the suite
INCUS_TOKEN=""
PROJECT_DIR="."
