name: proxy
services:
  backend1:
    restart: unless-stopped
    entrypoint:
      - /bin/sh
      - -c
      - mkdir -p /www && echo backend1-ok > /www/index.html && httpd -f -v -p 8080
        -h /www
    image: docker.io/library/busybox:glibc
    networks:
      default: null
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - --spider
        - http://127.0.0.1:8080
      timeout: 5s
      interval: 5s
      retries: 3
    x-incus:
      limits.cpu: 1
  backend2:
    restart: unless-stopped
    entrypoint:
      - /bin/sh
      - -c
      - mkdir -p /www && echo backend2-ok > /www/index.html && httpd -f -v -p 8080
        -h /www
    image: docker.io/library/busybox:glibc
    networks:
      default: null
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - --spider
        - http://127.0.0.1:8080
      timeout: 5s
      interval: 5s
      retries: 3
    x-incus:
      limits.cpu: 1
  frontend:
    restart: unless-stopped
    entrypoint:
      - /bin/sh
      - -c
      - mkdir -p /www && echo frontend-ok > /www/index.html && httpd -f -v -p 8080
        -h /www
    image: docker.io/library/busybox:glibc
    networks:
      default: null
    depends_on:
      backend1:
        condition: service_healthy
        required: true
      backend2:
        condition: service_healthy
        required: true
    healthcheck:
      test:
        - CMD
        - wget
        - -q
        - --spider
        - http://127.0.0.1:8080
      timeout: 5s
      interval: 5s
      retries: 3
    x-incus:
      limits.cpu: 1
networks:
  default:
    name: proxy_default
