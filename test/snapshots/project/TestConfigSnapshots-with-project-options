name: with-project-options
services:
  web:
    deploy:
      replicas: 4
    restart: unless-stopped
    image: docker.io/alpine:edge
    networks:
      default: null
    x-incus:
      limits.cpu: "1"
      limits.memory: 512MiB
networks:
  default:
    name: with-project-options_default
x-incus:
  limits.cpu: "4"
  limits.memory: 2049MiB
  limits.virtual-machines: 0
x-incus-compose:
  healthd:
    external: true
