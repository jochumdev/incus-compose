name: test-local-config
services:
  always-restart:
    restart: always
    image: docker.io/library/alpine:latest
    networks:
      default: null
  default-restart:
    image: docker.io/library/alpine:latest
    networks:
      default: null
  no-restart:
    restart: 'no'
    image: docker.io/library/alpine:latest
    networks:
      default: null
  on-failure-restart:
    restart: on-failure
    image: docker.io/library/alpine:latest
    networks:
      default: null
  unless-stopped-restart:
    restart: unless-stopped
    image: docker.io/library/alpine:latest
    networks:
      default: null
networks:
  default:
    name: test-local-config_default
