# https://hub.docker.com/r/sameersbn/apt-cacher-ng
export VERSION="3.7.4-20220421"

export STORAGE_POOL=""

# Static IP
export NET_EXTERNAL="true"
export NET_NAME="incusbr0"
export IPV4_GATEWAY="10.167.160.1"
export IPV4_NETMASK="24"
export IPV4_ACNG="10.167.160.32"

# A static address gets no resolver handed to it, and the cache resolves every
# upstream it fetches from.
export IPV4_DNS="10.167.160.1"
