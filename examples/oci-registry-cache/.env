# https://quay.io/repository/appzygy/ociregistry
export VERSION="1.17.0"

export LOG_LEVEL="info"

# Docker Hub account name and a personal access token, to pull authenticated and
# get the higher rate limit. Leave both empty to pull anonymously.
export DOCKERIO_USER=""
export DOCKERIO_TOKEN=""

export STORAGE_POOL=""

export NETWORK_EXTERNAL="false"
export NETWORK="registry0"
export IPV4_NETMASK="24"
export GATEWAY_IPV4="10.132.32.1"
export REGISTRY_IPV4="10.132.32.17"
