# Where this stack's addresses are written, once. compose.yaml reads them through
# incus-compose's own interpolation; coredns/Corefile.tmpl is rendered from the
# same file by the e2e before the stack comes up.
#
# IPV4_GATEWAY is the dns bridge's own address, which is where incusd listens for
# the bridges it manages and where CoreDNS forwards what it cannot answer.
IPV4_GATEWAY=10.233.133.1

# IPV4_COREDNS is the address the coredns service pins and every instance names
# in resolv.conf. It has to sit inside IPV4_GATEWAY's subnet.
IPV4_COREDNS=10.233.133.11

# INCUS_PORT is the HTTPS API port incusd serves.
INCUS_PORT=8443

# Normally set by the test suite.
PROJECT_NAME=shop
PROJECT_ROOT=.
DNS_SEARCH="shop.incus"
COREDNS_DATA_DIR="/tmp/shop_coredns"
INCUS_TOKEN=""
