module github.com/lxc/incus-compose/benchmarks/coredns/kubernetes

go 1.26.5

// Pinned to what CoreDNS itself requires, taken from the checkout in
// work/vendor/coredns. The kubernetes plugin imports packages that later
// k8s.io/api releases have dropped, so resolving these at @latest is what used
// to leave this module unbuildable.
require (
	github.com/coredns/coredns v1.14.6
	github.com/miekg/dns v1.1.72
	k8s.io/api v0.35.4
