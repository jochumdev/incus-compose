FROM busybox:glibc

ARG TARGETPLATFORM
ARG VERSION

COPY ${TARGETPLATFORM}/ic-dns /usr/local/bin/ic-dns

# Sets GOMEMLIMIT from the cgroup limit before handing over. Nothing else bounds
# the Go heap, so a limits.memory that fits today's fleet OOM-kills on a larger
# one without it.
COPY --chmod=0755 container/ic-dns/entrypoint.sh /usr/local/bin/entrypoint.sh

USER 65534:65534

ENTRYPOINT ["entrypoint.sh"]

# Everything else comes from the environment: DNS_INCUS, DNS_TOKEN,
# DNS_FORWARD and the rest, which is what a compose file sets. There is no
# configuration file to mount.
CMD ["run"]
