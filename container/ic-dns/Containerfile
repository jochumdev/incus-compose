ARG GO_VERSION=1.26.7-trixie
# Root, not :nonroot - ic-dns binds port 53 here, and resolv.conf has no port
# field, so a client can only ever name the privileged one.
ARG BASE=docker.io/library/busybox:glibc

FROM docker.io/library/golang:${GO_VERSION} AS build

# The build context is the repository root, and the whole tree is one module -
# no go.work, no nested modules but the benchmarks, which nothing here builds.
# This is not a CoreDNS distribution: main composes the chain itself, so there
# is no CoreDNS checkout to clone, no `go generate`, and no plugin.cfg.
WORKDIR /src
COPY . .

ARG VERSION=dev

# Verified in the builder rather than trusted. The version subcommand is the
# cheapest thing that proves the binary links and its command tree parses -
# which is what a chain composed at compile time can silently get wrong.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags "-X main.version=${VERSION}" -o /out/ic-dns ./cmd/ic-dns && \
    /out/ic-dns version && \
    /out/ic-dns run --help > /dev/null

FROM ${BASE}
COPY --from=build /out/ic-dns /usr/local/sbin/ic-dns

WORKDIR /

# 53 is the answer, 8080 is /metrics, /health and /ready.
EXPOSE 53 53/udp 8080

# Everything else comes from the environment: DNS_INCUS, DNS_TOKEN,
# DNS_FORWARD and the rest, which is what a compose file sets. There is no
# configuration file to mount.
CMD ["ic-dns", "run"]
